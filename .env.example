# ====================================
# DJ Booking - Environnement Config
# ====================================

# SERVER CONFIGURATION
PORT=3000
NODE_ENV=production

# DISCORD WEBHOOKS
# Copier depuis Discord → Serveur → Intégrations → Webhooks
DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# CORS CONFIGURATION
ALLOWED_ORIGINS=http://localhost:3000,https://events.cax-corp.com

# ====================================
# CLOUDFLARE WORKERS CONFIG
# ====================================
# (À ajouter après migration)

# Dans wrangler.toml, ajouter:
# [[kv_namespaces]]
# binding = "RESERVATIONS_KV"
# id = "votre-kv-id"
# preview_id = "votre-preview-id"

# [[r2_buckets]]
# binding = "BUCKET"
# bucket_name = "dj-booking-assets"

# Secrets (via: wrangler secret put)
# DISCORD_WEBHOOK="..." (même que ci-dessus)

